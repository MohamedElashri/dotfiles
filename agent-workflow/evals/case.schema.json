{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dotfiles:agent-eval:case:1",
  "title": "Synthetic evaluation case v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "task",
    "fixture",
    "acceptance_checks",
    "timeout_seconds",
    "expected_change_scope",
    "required_capabilities",
    "examples",
    "trust"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z][0-9]{2}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "sha256"
      ],
      "properties": {
        "files": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "additionalProperties": {
            "type": "string",
            "maxLength": 262144
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "acceptance_checks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "enum": [
            "commit",
            "pr",
            "mean",
            "normalize",
            "percentage",
            "review",
            "pipeline"
          ]
        },
        {
          "const": "scope"
        }
      ]
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "expected_change_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "python",
          "sqlite",
          "workspace-write"
        ]
      }
    },
    "examples": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "fail"
      ],
      "properties": {
        "pass": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "additionalProperties": {
            "type": "string",
            "maxLength": 262144
          }
        },
        "fail": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "additionalProperties": {
            "type": "string",
            "maxLength": 262144
          }
        }
      }
    },
    "trust": {
      "const": "synthetic-trusted"
    }
  },
  "description": "The stdlib validator also checks normalized relative paths, total file budgets, allowed check IDs and the SHA-256 of canonical sorted compact UTF-8 JSON fixture.files."
}
