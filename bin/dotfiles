#!/usr/bin/env bash
set -euo pipefail
file=${BASH_SOURCE[0]}
while [ -L "$file" ]; do
  directory=$(cd -P "$(dirname "$file")" && pwd)
  file=$(readlink "$file")
  case "$file" in /*) ;; *) file="$directory/$file" ;; esac
done
root=$(cd -P "$(dirname "$file")/.." && pwd)
command=${1:---help}
case "$command" in
  update|rollback)
    exec python3 "$root/scripts/update.py" "$@" ;;
  install)
    shift; exec bash "$root/install.sh" "$@" ;;
  status)
    shift; exec bash "$root/install.sh" "$@" --status ;;
  doctor)
    profile=
    if [ -r "$HOME/.config/dotfiles/profile" ]; then
      IFS= read -r profile < "$HOME/.config/dotfiles/profile" || true
    fi
    if [ "$profile" != personal ] || ! command -v python3 >/dev/null 2>&1 || [ "${2-}" = --profile ]; then
      shift; exec bash "$root/scripts/doctor.sh" "$@"
    fi
    ;;
  help) shift; set -- --help "$@" ;;
esac
exec python3 "$root/scripts/workflow.py" "$@"
