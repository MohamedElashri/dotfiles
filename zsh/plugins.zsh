# Generated by dotfiles render from setup/assets.json.
DOTFILES_OMZ_PLUGINS=(git zsh-autosuggestions you-should-use insult-zsh)
case "$(uname -s)" in
  Darwin) DOTFILES_OMZ_PLUGINS+=(history history-substring-search encode64 extract cp copypath copyfile sublime) ;;
  Linux) DOTFILES_OMZ_PLUGINS+=(adguard-helper) ;;
esac
if (( ${+DOTFILES_EXTRA_OMZ_PLUGINS} )); then
  DOTFILES_OMZ_PLUGINS+=("${DOTFILES_EXTRA_OMZ_PLUGINS[@]}")
fi
DOTFILES_OMZ_PLUGINS+=(zsh-syntax-highlighting)
